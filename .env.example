# Kopieren nach .env und Werte setzen. .env niemals committen.

# Muss URL-sicher sein (steht in DATABASE_URL): nur Hex/Buchstaben/Ziffern,
# keine Sonderzeichen wie + / = $ @ :   Erzeugen mit: openssl rand -hex 32
POSTGRES_PASSWORD=

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
JWT_SECRET=

TZ=Europe/Berlin
# Optional: anderer Host-Port für die API
# API_PORT=3000
