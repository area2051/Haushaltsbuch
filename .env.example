# Kopieren nach .env und Werte setzen. .env niemals committen.

# Muss URL-sicher sein (steht in DATABASE_URL): nur Hex/Buchstaben/Ziffern,
# keine Sonderzeichen wie + / = $ @ :   Erzeugen mit: openssl rand -hex 32
POSTGRES_PASSWORD=

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
JWT_SECRET=

TZ=Europe/Berlin
# Optional: anderer Host-Port für die API
# API_PORT=3000

# Optional: Speicherorte für Datenbank und Backups (Standard ./data bzw. ./backups).
# Auf dem Mac liegt das Repo in OneDrive: hier unbedingt absolute Pfade AUSSERHALB
# von OneDrive setzen, sonst kann der Sync-Client die Datenbank beschädigen.
# DATA_DIR=/Users/<name>/haushaltsbuch-data
# BACKUP_DIR=/Users/<name>/haushaltsbuch-backups
